cat > create_images.py << 'EOF'
from PIL import Image

# Krijo folderin img
import os
if not os.path.exists('img'):
    os.makedirs('img')

# Krijo dice.bmp
img = Image.new('RGB', (800, 600), color=(200, 100, 50))
img.save('img/dice.bmp')
print("dice.bmp u krijua")

# Krijo flowers.bmp
img = Image.new('RGB', (1024, 768), color=(100, 200, 150))
img.save('img/flowers.bmp')
print("flowers.bmp u krijua")

# Krijo tiger.bmp
img = Image.new('RGB', (1920, 1080), color=(50, 100, 200))
img.save('img/tiger.bmp')
print("tiger.bmp u krijua")

print("\nTe gjitha fotot u krijuan ne folderin 'img/'")
EOF
